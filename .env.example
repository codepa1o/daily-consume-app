# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Travel planning uses the DeepSeek settings above by default.
# AMap Web Service key (required for travel planning and POI/map APIs).
AMAP_API_KEY=your_amap_web_service_key

# Flutter Android/Web client maps: AMap JavaScript API key, restricted in AMap Console.
AMAP_WEB_JS_KEY=your_amap_web_js_key
# Optional, only when enabled for the JavaScript key in AMap Console.
# AMAP_WEB_JS_SECURITY_CODE=

# Optional: Unsplash access key enables attraction photos.
UNSPLASH_ACCESS_KEY=

# Optional: use a separate personalized planner model.
# USE_PERSONALIZED_PLANNER=false
# PERSONALIZED_LLM_BASE_URL=
# PERSONALIZED_LLM_MODEL_ID=
# PERSONALIZED_LLM_PROVIDER=openai

# PostgreSQL libpq connection string. Leave blank to use the default local socket.
# Example: postgresql://daily_consume:change-me@127.0.0.1:5432/daily_consume
DATABASE_URL=

# 微信小程序登录；AppSecret 只配置在服务端环境。
WECHAT_MINIPROGRAM_APPID=wxdd91816241715da2
WECHAT_MINIPROGRAM_APPSECRET=
# Optional: approved one-time subscription template for Pomodoro reminders.
WECHAT_POMODORO_TEMPLATE_ID=
# Configure field IDs for the template selected in the WeChat console.
# WECHAT_POMODORO_TEMPLATE_FIELDS={"thing1":"task","time2":"deadline","thing3":"phase"}

# 技能代理、聊天机器人和旅行规划共用 DeepSeek 配置。
DEEPSEEK_API_MODE=chat_completions
DEEPSEEK_REVIEW_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_DISABLE_RESPONSE_STORAGE=true
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
SEARCH_ENABLED=true
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_SCORE=0.2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
SKILL_AGENT_WORKER_ENABLED=true

# Optional stdio MCP servers available to the chatbot. Keep credentials in the server environment.
# Example: [{"name":"local-tools","command":"npx","args":["-y","some-mcp-server"],"env":{"API_KEY":"..."}}]
# The default protocol version is 2024-11-05; set protocol_version to 2026-07-28 for a modern server.
CHATBOT_MCP_SERVERS=[]
