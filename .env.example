# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Travel planning uses the DeepSeek settings above by default.
# AMap Web Service key (required for travel planning and POI/map APIs).
AMAP_API_KEY=your_amap_web_service_key

# Optional: Unsplash access key enables attraction photos.
UNSPLASH_ACCESS_KEY=

# Optional: override the shared DeepSeek LLM configuration for travel planning.
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL_ID=

# Optional: use a separate personalized planner model.
# USE_PERSONALIZED_PLANNER=false
# PERSONALIZED_LLM_API_KEY=
# PERSONALIZED_LLM_BASE_URL=
# PERSONALIZED_LLM_MODEL_ID=
# PERSONALIZED_LLM_PROVIDER=openai

# PostgreSQL libpq connection string. Leave blank to use the default local socket.
# Example: postgresql://daily_consume:change-me@127.0.0.1:5432/daily_consume
DATABASE_URL=

# Skill Agent。模型密钥只保存在服务端；搜索与知识库配置为可选。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.freemodel.dev
OPENAI_MODEL=gpt-5.5
OPENAI_REVIEW_MODEL=gpt-5.4
OPENAI_API_MODE=responses
OPENAI_REASONING_EFFORT=low
OPENAI_DISABLE_RESPONSE_STORAGE=true
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=4096
SEARCH_ENABLED=true
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_SCORE=0.2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
SKILL_AGENT_WORKER_ENABLED=true
