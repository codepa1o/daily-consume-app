.page { padding: 22rpx; }
.card { margin-bottom: 16rpx; padding: 22rpx; border-radius: 20rpx; background: #fffefa; }
.month, .section-row, .publish, .comment-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.month { color: #64765a; font-size: 30rpx; }
.month text:first-child, .month text:last-child { padding: 4rpx 20rpx; font-size: 42rpx; }
.section-title { font-size: 30rpx; font-weight: 650; }
.small, .primary, .danger { margin: 10rpx 0; padding: 0 16rpx; height: 58rpx; line-height: 58rpx; border-radius: 12rpx; font-size: 21rpx; }
.small { color: #45543e; background: #e9eee4; }.primary { color: #fff; background: #64765a; }.danger { color: #9b4339; background: #f8ece9; }
.conflict-title, .sub-title { display: block; margin-bottom: 8rpx; font-weight: 650; }
.muted { display: block; margin: 8rpx 0; color: #85897f; font-size: 21rpx; }
.conflict { display: flex; flex-direction: column; gap: 8rpx; }
.overlay { position: fixed; inset: 0; z-index: 20; display: flex; align-items: flex-end; background: rgba(30,32,28,.4); }
.editor { box-sizing: border-box; width: 100%; max-height: 92vh; overflow-y: auto; padding: 26rpx; border-radius: 24rpx 24rpx 0 0; }
.close { color: #64765a; font-size: 36rpx; padding: 5rpx 15rpx; }
.summary { display: block; margin: 12rpx 0; line-height: 1.5; }
.field { box-sizing: border-box; width: 100%; margin: 10rpx 0; padding: 14rpx; border: 1rpx solid #e8e7df; border-radius: 12rpx; }
textarea.field { height: 100rpx; }
.picker { color: #64765a; }
.publish { padding: 10rpx 0; }
.reflection { margin-top: 14rpx; padding: 14rpx; border-radius: 12rpx; background: #f6f5ef; }
.comment { display: flex; gap: 12rpx; padding: 10rpx 0; border-bottom: 1rpx solid #f0efe8; }
.comment-row .field { flex: 1; }
.error { display: flex; justify-content: space-between; color: #9b4339; }.link { margin: 0; color: #64765a; background: transparent; }
