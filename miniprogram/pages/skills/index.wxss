.page { padding: 18rpx; }
.tabs { white-space: nowrap; margin-bottom: 14rpx; }
.tab-row { display: inline-flex; gap: 8rpx; }
.tab { padding: 12rpx 20rpx; border-radius: 24rpx; color: #70756b; background: #f0efe8; font-size: 22rpx; }
.tab.active { color: #fffefa; background: #64765a; }
.card { margin-bottom: 16rpx; padding: 20rpx; border-radius: 18rpx; background: #fffefa; }
.section-title { display: block; margin-bottom: 12rpx; font-size: 28rpx; font-weight: 650; }
.row { display: flex; align-items: center; gap: 10rpx; }
.row > view, .row .picker { flex: 1; }
.small, .tiny, .primary { margin: 8rpx 0; padding: 0 16rpx; height: 56rpx; line-height: 56rpx; color: #45543e; background: #e9eee4; font-size: 21rpx; }
.tiny { height: 48rpx; line-height: 48rpx; padding: 0 10rpx; }
.primary { color: #fffefa; background: #64765a; }
.danger { color: #9b4339; background: #f8ece9; }
.picker { overflow: hidden; color: #64765a; white-space: nowrap; text-overflow: ellipsis; }
.field, .question { box-sizing: border-box; width: 100%; margin: 10rpx 0; padding: 14rpx; border: 1rpx solid #e8e7df; border-radius: 12rpx; }
.question { min-height: 100rpx; }
.message { display: flex; flex-direction: column; gap: 8rpx; margin-top: 16rpx; padding: 14rpx; border-radius: 12rpx; background: #f6f5ef; }
.role { color: #64765a; font-weight: 650; }
.content { display: block; margin-top: 12rpx; white-space: pre-wrap; line-height: 1.55; }
.err-text { color: #9b4339; }
.status { display: block; margin: 12rpx 0; color: #64765a; font-size: 21rpx; }
.list-row, .case { display: flex; flex-direction: column; gap: 7rpx; padding: 14rpx 0; border-bottom: 1rpx solid #f0efe8; }
.muted, .label, .hint { display: block; margin-top: 8rpx; color: #85897f; font-size: 20rpx; }
.label { color: #64765a; }
.error { display: flex; justify-content: space-between; color: #9b4339; }
.link { margin: 0; color: #64765a; background: transparent; }
