<view class="page">
  <scroll-view scroll-x class="tabs"><view class="tab-row"><text wx:for="{{tabs}}" wx:key="id" class="tab {{tab === item.id ? 'active' : ''}}" data-tab="{{item.id}}" bindtap="switchTab">{{item.label}}</text></view></scroll-view>
  <view wx:if="{{error}}" class="card error"><text>{{error}}</text><button class="link" bindtap="retry">重试</button></view>
  <view wx:if="{{loading}}" class="card hint">正在加载…</view>

  <view wx:if="{{tab === 'chat'}}" class="workspace">
    <view class="card row"><button class="small" bindtap="newConversation">＋ 新对话</button><picker wx:if="{{conversations.length}}" mode="selector" range="{{conversations}}" range-key="title" bindchange="onConversationPick"><view class="picker">{{conversationTitle || '选择历史对话'}}　›</view></picker></view>
    <view class="card"><text class="label">Skill URL</text><input class="field" value="{{skillUrl}}" disabled="{{activeConversationId}}" bindinput="onSkillUrl" /><input wx:if="{{!activeConversationId}}" class="field" placeholder="对话标题（可选）" value="{{titleInput}}" bindinput="onTitle" /><view wx:for="{{messages}}" wx:key="id" class="message"><text class="role">{{item.role === 'user' ? '我' : '技能代理'}}</text><text class="content">{{item.content}}</text><text wx:if="{{item.error_message}}" class="err-text">{{item.error_message}}</text></view><text wx:if="{{status && busy}}" class="status">{{status}}</text><textarea class="question" maxlength="12000" placeholder="描述任务或提出问题" value="{{question}}" bindinput="onQuestion" /><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="sendMessage">发送</button><view wx:if="{{activeConversationId}}" class="row actions"><button class="small" bindtap="renameConversation">重命名</button><button class="small danger" bindtap="deleteConversation">删除对话</button></view></view>
    <view class="card list"><text class="section-title">对话记录</text><view wx:for="{{conversations}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="openConversation"><text>{{item.title}}</text><text class="muted">{{item.message_count}} 条 · {{item.last_question}}</text></view></view>
  </view>

  <view wx:if="{{tab === 'runs'}}" class="workspace">
    <view class="card"><text class="section-title">运行 Skill</text><input class="field" value="{{skillUrl}}" bindinput="onSkillUrl" /><textarea class="question" placeholder="输入要执行的任务" value="{{question}}" bindinput="onQuestion" /><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="startRun">开始运行</button><text wx:if="{{status}}" class="status">{{status}}</text><text wx:if="{{answer}}" class="content">{{answer}}</text></view>
    <view wx:if="{{activeRun}}" class="card"><view class="row"><text class="section-title">运行 #{{activeRun.id}}</text><button class="small" bindtap="rerun">重跑</button></view><text class="muted">{{activeRun.skill_url}} · {{activeRun.status}}</text><text class="content">{{activeRun.answer || activeRun.error_message}}</text></view>
    <view class="card list"><text class="section-title">运行历史</text><view wx:for="{{runs}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="openRun"><text>#{{item.id}} · {{item.status}}</text><text class="muted">{{item.question}}</text></view></view>
  </view>

  <view wx:if="{{tab === 'knowledge'}}" class="workspace">
    <view class="card"><text class="section-title">本地知识库</text><text class="muted">支持 Markdown、TXT 和 PDF，单文件最大 10 MB。索引完成后可用于技能对话和评测。</text><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="uploadKnowledge">选择文件上传</button></view>
    <view class="card list"><text class="section-title">已上传资料</text><view wx:for="{{documents}}" wx:key="id" class="list-row"><view data-index="{{index}}" data-action="detail" bindtap="knowledgeAction"><text>{{item.filename}}</text><text class="muted">{{item.status}} · {{item.chunk_count}} 个片段 {{item.error_message}}</text></view><view class="row"><button class="tiny" data-index="{{index}}" data-action="reindex" bindtap="knowledgeAction">重建索引</button><button class="tiny danger" data-index="{{index}}" data-action="delete" bindtap="knowledgeAction">删除</button></view></view><text wx:if="{{!documents.length}}" class="muted">知识库为空</text></view>
    <view wx:if="{{documentDetail}}" class="card list"><view class="row"><text class="section-title">资料索引切片</text><button class="tiny" bindtap="closeDocumentDetail">关闭</button></view><view wx:for="{{documentDetail.chunks}}" wx:key="chunk_index" class="case"><text>片段 {{item.chunk_index + 1}} {{item.page_number ? '· 第 ' + item.page_number + ' 页' : ''}}</text><text class="content">{{item.content}}</text></view></view>
  </view>

  <view wx:if="{{tab === 'evals'}}" class="workspace">
    <view class="card"><text class="section-title">创建评测集</text><input class="field" placeholder="评测集名称" value="{{suiteName}}" data-field="suiteName" bindinput="onSuiteField" /><input class="field" placeholder="Skill URL" value="{{suiteUrl}}" data-field="suiteUrl" bindinput="onSuiteField" /><input class="field" placeholder="描述（可选）" value="{{suiteDescription}}" data-field="suiteDescription" bindinput="onSuiteField" /><button class="primary" bindtap="createSuite">创建评测集</button></view>
    <view class="card list"><text class="section-title">评测集</text><view wx:for="{{suites}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="openSuite"><text>{{item.name}} · {{item.case_count}} 个用例</text><text class="muted">{{item.skill_url}}</text></view></view>
    <view wx:if="{{activeSuite}}" class="card"><text class="section-title">{{activeSuite.name}}</text><text class="muted">{{activeSuite.description}}</text><view wx:for="{{suiteCases}}" wx:key="id" class="case"><text>{{item.title}}</text><text class="muted">{{item.question}}</text></view><text class="label">添加用例</text><input class="field" placeholder="用例标题" value="{{caseTitle}}" data-field="caseTitle" bindinput="onSuiteField" /><textarea class="question" placeholder="测试问题" value="{{caseQuestion}}" data-field="caseQuestion" bindinput="onSuiteField" /><textarea class="question" placeholder="期望行为" value="{{expectedBehavior}}" data-field="expectedBehavior" bindinput="onSuiteField" /><textarea class="question" placeholder="评分重点" value="{{scoringFocus}}" data-field="scoringFocus" bindinput="onSuiteField" /><view class="row"><button class="small" bindtap="addCase">添加用例</button><button class="primary" bindtap="runSuite">运行评测</button></view></view>
    <view wx:if="{{evalReport}}" class="card"><text class="section-title">评测状态：{{jobStatus}}</text><text class="muted">平均分：{{evalReport.run.average_score}}</text><view wx:for="{{evalReport.results}}" wx:key="id" class="case"><text>{{item.case_title}} · {{item.variant}} · {{item.score}}</text><text class="muted">{{item.feedback}}</text></view></view>
  </view>

  <view wx:if="{{tab === 'diagnostics'}}" class="workspace"><view class="card"><text class="section-title">服务诊断</text><text class="muted">接口模式：{{diagnostics.api_mode}} · 推理强度：{{diagnostics.reasoning_effort}}</text><text class="muted">模型：{{diagnostics.model}} · 服务状态：{{diagnostics.status}}</text><text class="content">{{diagnostics.message}}</text><button class="primary" bindtap="loadDiagnostics">刷新诊断</button></view></view>
</view>
