.page { display: flex; flex-direction: column; height: 100vh; padding: 16rpx; box-sizing: border-box; }
.card { padding: 18rpx; border-radius: 18rpx; background: #fffefa; }
.toolbar { display: flex; align-items: center; gap: 12rpx; }
.list-toggle, .more { color: #64765a; font-size: 22rpx; }
.current-title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
.danger { color: #9b4339; }
.small { margin: 0; padding: 0 12rpx; background: #e9eee4; color: #45543e; }
.conversation-list { max-height: 320rpx; margin-top: 10rpx; overflow-y: auto; }
.conversation { display: flex; flex-direction: column; gap: 6rpx; padding: 12rpx; border-bottom: 1rpx solid #f0efe8; }
.conversation.active { background: #f0f3ed; }
.muted, .hint { color: #85897f; font-size: 21rpx; }
.messages { flex: 1; min-height: 200rpx; margin: 12rpx 0; }
.message { display: flex; flex-direction: column; margin: 14rpx 0; padding: 18rpx; border-radius: 16rpx; background: #fffefa; }
.message.user { margin-left: 70rpx; background: #e9eee4; }
.message.assistant { margin-right: 35rpx; }
.role { margin-bottom: 10rpx; color: #64765a; font-size: 20rpx; font-weight: 650; }
.content { white-space: pre-wrap; line-height: 1.6; }
.message-error { margin-top: 10rpx; color: #9b4339; }
.sources { margin-top: 12rpx; padding-top: 10rpx; border-top: 1rpx solid #eee; color: #70756b; font-size: 20rpx; }
.status { padding: 8rpx; color: #64765a; font-size: 21rpx; }
.attachment { padding: 8rpx 14rpx; color: #64765a; }
.remove { margin-left: 14rpx; color: #9b4339; }
.composer { padding: 14rpx; }
.question { width: 100%; min-height: 90rpx; }
.composer-row, .options, .buttons { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.options { justify-content: flex-start; color: #64765a; font-size: 21rpx; }
.options text { display: flex; align-items: center; }
.options switch { transform: scale(.75); }
.send { margin: 0; padding: 0 24rpx; height: 62rpx; line-height: 62rpx; background: #64765a; color: #fffefa; font-size: 23rpx; }
.stop { margin: 0; padding: 0 20rpx; height: 62rpx; line-height: 62rpx; background: #f8ece9; color: #9b4339; font-size: 22rpx; }
.error { display: flex; justify-content: space-between; color: #9b4339; }
.link { margin: 0; color: #64765a; background: transparent; }
.overlay { position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; background: rgba(30,32,28,.38); }
.editor { width: 100%; padding: 30rpx; border-radius: 24rpx 24rpx 0 0; }
.section-title { display: block; margin-bottom: 16rpx; font-size: 30rpx; font-weight: 650; }
.field { box-sizing: border-box; width: 100%; padding: 16rpx; border: 1rpx solid #e8e7df; border-radius: 12rpx; }
