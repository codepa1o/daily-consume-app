.page { padding: 22rpx; }
.card { margin-bottom: 18rpx; padding: 24rpx; border-radius: 22rpx; background: #fffefa; }
.section-title { display: block; margin-bottom: 14rpx; font-size: 30rpx; font-weight: 650; }
.field { margin: 12rpx 0; padding: 16rpx; border: 1rpx solid #e8e7df; border-radius: 12rpx; }
.label, .meta, .authors { display: block; margin: 10rpx 0; color: #85897f; font-size: 21rpx; }
.sources { display: flex; flex-wrap: wrap; gap: 10rpx; }
.source { padding: 9rpx 15rpx; border-radius: 20rpx; color: #70756b; background: #f3f2ec; font-size: 21rpx; }
.source.chosen { color: #fffefa; background: #64765a; }
.picker { padding: 14rpx 0; color: #64765a; }
.primary, .download { margin: 10rpx 0 0; border-radius: 13rpx; color: #fffefa; background: #64765a; }
.title { display: block; color: #292c25; font-size: 27rpx; font-weight: 650; line-height: 1.5; }
.row { display: flex; gap: 10rpx; align-items: center; }
.row button { flex: 1; }
.small { margin: 10rpx 0 0; color: #45543e; background: #e9eee4; }
.abstract { display: block; max-height: 220rpx; overflow: hidden; line-height: 1.6; color: #4f544b; font-size: 22rpx; }
.warning { color: #856a37; background: #fbf6e9; }
.saved-row { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid #f0efe8; }
.saved-title { flex: 1; color: #64765a; font-size: 22rpx; }
.remove { padding: 0 12rpx; color: #9b4339; font-size: 34rpx; }
.error { display: flex; justify-content: space-between; color: #9b4339; }
.link { margin: 0; color: #64765a; background: transparent; }
