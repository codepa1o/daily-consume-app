.page { padding: 24rpx; }
.card { padding: 24rpx; border-radius: 20rpx; background: #fffefa; }
.heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.version { color: #64765a; font-size: 30rpx; font-weight: 700; }
.date { color: #85897f; font-size: 21rpx; }
.note { display: block; margin: 10rpx 0; color: #4f544b; font-size: 23rpx; line-height: 1.5; }
