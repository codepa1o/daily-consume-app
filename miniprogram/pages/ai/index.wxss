.page { padding: 22rpx; }
.card { margin-bottom: 18rpx; padding: 24rpx; border-radius: 22rpx; background: #fffefa; }
.modes { display: flex; gap: 16rpx; }
.mode { flex: 1; padding: 14rpx; border-radius: 12rpx; color: #70756b; text-align: center; background: #f3f2ec; }
.mode.active { color: #fffefa; background: #64765a; }
.date { color: #64765a; }
.title { display: block; font-size: 34rpx; font-weight: 700; }
.subtitle, .muted, .caption, .notice, .hint { display: block; margin-top: 10rpx; color: #85897f; font-size: 21rpx; }
.summary { display: block; margin-top: 20rpx; line-height: 1.65; white-space: pre-wrap; }
.highlights { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.highlight { box-sizing: border-box; width: calc(50% - 6rpx); display: flex; flex-direction: column; padding: 16rpx; border-radius: 14rpx; background: #f6f5ef; }
.highlight-value { color: #64765a; font-size: 29rpx; font-weight: 650; }
.section { margin-top: 24rpx; }
.section-title { display: block; margin-bottom: 10rpx; font-size: 27rpx; font-weight: 650; }
.item { display: block; margin: 8rpx 0; line-height: 1.6; white-space: pre-wrap; }
.notice { padding-top: 16rpx; border-top: 1rpx solid #f0efe8; }
.primary { margin: 0 22rpx; border-radius: 14rpx; color: #fffefa; background: #64765a; }
.error { display: flex; justify-content: space-between; color: #9b4339; }
.link { margin: 0; color: #64765a; background: transparent; }
