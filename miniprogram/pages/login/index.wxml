<view class="page">
  <view class="brand">日常</view>
  <view class="subtitle">身体、饮食消费与健身记录</view>

  <view class="form card">
    <text class="title">{{mode === 'login' ? '欢迎回来' : '创建账号'}}</text>
    <input class="input" placeholder="用户名" maxlength="32" value="{{username}}" bindinput="onUsernameInput" />
    <input class="input" placeholder="密码（至少 8 位）" password maxlength="128" value="{{password}}" bindinput="onPasswordInput" />
    <input wx:if="{{mode === 'register'}}" class="input" placeholder="昵称（可选）" maxlength="32" value="{{nickname}}" bindinput="onNicknameInput" />
    <text wx:if="{{error}}" class="error">{{error}}</text>
    <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">
      {{mode === 'login' ? '登录' : '注册并登录'}}
    </button>
    <button wx:if="{{mode === 'login'}}" class="wechat" loading="{{busy}}" disabled="{{busy}}" bindtap="submitWechat">微信快捷登录</button>
    <view class="consent"><checkbox-group bindchange="onConsent"><checkbox value="agree" checked="{{consented}}" /></checkbox-group><text>我已阅读并同意</text><navigator url="/pages/privacy/index" class="privacy-link">隐私保护指引</navigator></view>
    <button class="text-button" disabled="{{busy}}" bindtap="toggleMode">
      {{mode === 'login' ? '还没有账号？注册' : '已有账号？返回登录'}}
    </button>
  </view>
</view>
